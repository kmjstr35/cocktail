<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
        android:name=".MyApplication"
        tools:targetApi="31">
        <activity
            android:name=".RealMainWindow.IntroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AddCockTail.AddCockTail"
            android:windowSoftInputMode="adjustPan"
            android:exported="true"/>
        <activity android:name=".DetailedView.DetailedActivity"/>
        <activity android:name=".MainWindow.MainActivity"
            android:exported="true"/>
        <activity android:name=".EditCockTail.EditCockTail"
            android:windowSoftInputMode="adjustPan"
            android:exported="true" />

        <activity android:name=".RemoteRatingView.DetailedViewWithRemote"/>
        <activity android:name=".RemoteRatingView.RemoteRatingActivity"/>


    </application>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

</manifest>